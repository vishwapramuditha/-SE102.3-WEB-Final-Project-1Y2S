<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <linearGradient id="bg5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a1a00"/>
      <stop offset="60%" stop-color="#102800"/>
      <stop offset="100%" stop-color="#1a1000"/>
    </linearGradient>
    <linearGradient id="gbar5" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#84cc16"/>
      <stop offset="100%" stop-color="#00a86b"/>
    </linearGradient>
    <linearGradient id="overlay5" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0a1a00" stop-opacity="0.97"/>
      <stop offset="55%" stop-color="#0a1a00" stop-opacity="0.80"/>
      <stop offset="100%" stop-color="#0a1a00" stop-opacity="0.0"/>
    </linearGradient>
    <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#fbbf24" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bg5)"/>
  <!-- Sun glow -->
  <circle cx="660" cy="130" r="100" fill="url(#sunGlow)"/>
  <circle cx="660" cy="130" r="45" fill="#fbbf24" opacity="0.85"/>
  <circle cx="660" cy="130" r="38" fill="#fde68a"/>
  <!-- Sun rays -->
  <g stroke="#fbbf24" stroke-width="2" opacity="0.4">
    <line x1="660" y1="60" x2="660" y2="40"/><line x1="660" y1="200" x2="660" y2="220"/>
    <line x1="590" y1="130" x2="570" y2="130"/><line x1="730" y1="130" x2="750" y2="130"/>
    <line x1="610" y1="80" x2="595" y2="65"/><line x1="710" y1="80" x2="725" y2="65"/>
    <line x1="610" y1="180" x2="595" y2="195"/><line x1="710" y1="180" x2="725" y2="195"/>
  </g>
  <!-- Solar panels array -->
  <g transform="translate(460, 250)">
    <!-- Panel row 1 -->
    <rect x="0" y="0" width="72" height="48" rx="3" fill="#1a3a6a" stroke="#38bdf8" stroke-width="1"/>
    <line x1="24" y1="0" x2="24" y2="48" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="48" y1="0" x2="48" y2="48" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="0" y1="16" x2="72" y2="16" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="0" y1="32" x2="72" y2="32" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <rect x="80" y="0" width="72" height="48" rx="3" fill="#1a3a6a" stroke="#38bdf8" stroke-width="1"/>
    <line x1="104" y1="0" x2="104" y2="48" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="128" y1="0" x2="128" y2="48" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="80" y1="16" x2="152" y2="16" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="80" y1="32" x2="152" y2="32" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <rect x="160" y="0" width="72" height="48" rx="3" fill="#1a3a6a" stroke="#38bdf8" stroke-width="1"/>
    <line x1="184" y1="0" x2="184" y2="48" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="208" y1="0" x2="208" y2="48" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="160" y1="16" x2="232" y2="16" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <line x1="160" y1="32" x2="232" y2="32" stroke="#38bdf8" stroke-width="0.8" opacity="0.6"/>
    <!-- Panel row 2 -->
    <rect x="0" y="56" width="72" height="48" rx="3" fill="#1e4480" stroke="#84cc16" stroke-width="1"/>
    <line x1="24" y1="56" x2="24" y2="104" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="48" y1="56" x2="48" y2="104" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="0" y1="72" x2="72" y2="72" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="0" y1="88" x2="72" y2="88" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <rect x="80" y="56" width="72" height="48" rx="3" fill="#1e4480" stroke="#84cc16" stroke-width="1"/>
    <line x1="104" y1="56" x2="104" y2="104" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="128" y1="56" x2="128" y2="104" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="80" y1="72" x2="152" y2="72" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="80" y1="88" x2="152" y2="88" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <rect x="160" y="56" width="72" height="48" rx="3" fill="#1e4480" stroke="#84cc16" stroke-width="1"/>
    <line x1="184" y1="56" x2="184" y2="104" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="208" y1="56" x2="208" y2="104" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="160" y1="72" x2="232" y2="72" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <line x1="160" y1="88" x2="232" y2="88" stroke="#84cc16" stroke-width="0.8" opacity="0.6"/>
    <!-- Energy line -->
    <polyline points="116,0 116,-20 300,-20" fill="none" stroke="#84cc16" stroke-width="1.5" stroke-dasharray="5,3" opacity="0.6"/>
    <text x="230" y="-26" font-family="monospace" font-size="10" fill="#84cc16" opacity="0.8">42.8 kW</text>
  </g>
  <!-- Ground line -->
  <line x1="450" y1="358" x2="800" y2="358" stroke="#2d5020" stroke-width="1" opacity="0.5"/>
  <!-- Left overlay -->
  <rect width="800" height="450" fill="url(#overlay5)"/>
  <!-- Accent bar -->
  <rect x="0" y="0" width="5" height="450" fill="url(#gbar5)"/>
  <!-- Category badge -->
  <rect x="28" y="30" width="80" height="24" rx="4" fill="#84cc16"/>
  <text x="68" y="47" font-family="Inter,sans-serif" font-size="11" font-weight="700" fill="#0a1a00" text-anchor="middle" letter-spacing="0.5">GENERAL</text>
  <!-- Headline -->
  <text x="28" y="105" font-family="Georgia,serif" font-size="26" font-weight="bold" fill="#ffffff">Solar Canopy Expansion</text>
  <text x="28" y="138" font-family="Georgia,serif" font-size="26" font-weight="bold" fill="#ffffff">Completed Across</text>
  <text x="28" y="171" font-family="Georgia,serif" font-size="26" font-weight="bold" fill="#84cc16">North Parking Pavilion</text>
  <!-- Excerpt -->
  <text x="28" y="215" font-family="Inter,sans-serif" font-size="13" fill="rgba(255,255,255,0.65)">New 42kW solar installation brings NSBM closer</text>
  <text x="28" y="233" font-family="Inter,sans-serif" font-size="13" fill="rgba(255,255,255,0.65)">to its 2030 carbon-neutral campus target.</text>
  <!-- Meta -->
  <text x="28" y="285" font-family="Inter,sans-serif" font-size="11" fill="rgba(255,255,255,0.40)">NSBM NewsDesk  •  Sustainability  •  nsbm.ac.lk</text>
  <!-- NSBM badge -->
  <rect x="28" y="400" width="130" height="28" rx="14" fill="rgba(132,204,22,0.12)" stroke="#84cc16" stroke-width="1"/>
  <text x="93" y="419" font-family="Inter,sans-serif" font-size="11" font-weight="700" fill="#84cc16" text-anchor="middle" letter-spacing="0.5">NSBM GREEN UNIV.</text>
</svg>
