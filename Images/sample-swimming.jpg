<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="swimBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#082f49" />
      <stop offset="50%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#0f766e" />
    </linearGradient>
    <linearGradient id="waterFlow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.2" />
      <stop offset="50%" stop-color="#67e8f9" stop-opacity="0.5" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.2" />
    </linearGradient>
  </defs>

  <rect width="800" height="450" fill="url(#swimBg)" />

  <g stroke="#f8fafc" stroke-width="2" stroke-dasharray="12 8" opacity="0.4">
    <line x1="400" y1="450" x2="400" y2="120" stroke-width="3" />
    <line x1="240" y1="450" x2="310" y2="120" />
    <line x1="80" y1="450" x2="220" y2="120" />
    <line x1="560" y1="450" x2="490" y2="120" />
    <line x1="720" y1="450" x2="580" y2="120" />
  </g>

  <path d="M 0 240 Q 200 200 400 240 T 800 240 L 800 450 L 0 450 Z" fill="url(#waterFlow)" />
  <path d="M 0 310 Q 200 280 400 310 T 800 310 L 800 450 L 0 450 Z" fill="url(#waterFlow)" opacity="0.6" />

  <g fill="#0369a1" stroke="#38bdf8" stroke-width="1.5">
    <rect x="200" y="100" width="36" height="24" rx="3" />
    <rect x="290" y="100" width="36" height="24" rx="3" />
    <rect x="382" y="100" width="36" height="24" rx="3" fill="#0284c7" />
    <rect x="472" y="100" width="36" height="24" rx="3" />
    <rect x="562" y="100" width="36" height="24" rx="3" />
  </g>

  <g transform="translate(400, 260)">
    <ellipse cx="0" cy="0" rx="32" ry="14" fill="#0369a1" stroke="#e0f2fe" stroke-width="1.5" />
    <circle cx="28" cy="-2" r="10" fill="#fed7aa" />
    <path d="M 24 -11 C 36 -11 38 4 28 6 Z" fill="#0284c7" />
    <rect x="30" y="-3" width="7" height="4" rx="1" fill="#38bdf8" />
    <path d="M -5 -8 C 15 -35 50 -35 70 -12" fill="none" stroke="#fed7aa" stroke-width="8" stroke-linecap="round" />
    <path d="M -15 8 C -35 30 -60 20 -75 0" fill="none" stroke="#fed7aa" stroke-width="8" stroke-linecap="round" />
    <circle cx="68" cy="-12" r="6" fill="#e0f2fe" opacity="0.8" />
    <circle cx="78" cy="-18" r="4" fill="#e0f2fe" opacity="0.6" />
    <circle cx="-75" cy="0" r="5" fill="#e0f2fe" opacity="0.8" />
  </g>

  <g transform="translate(680, 110)">
    <polygon points="-12,-40 0,-15 12,-40 6,-40 0,-26 -6,-40" fill="#dc2626" />
    <circle cx="0" cy="0" r="28" fill="#eab308" stroke="#ca8a04" stroke-width="3" />
    <circle cx="0" cy="0" r="22" fill="#fef08a" stroke="#eab308" stroke-width="1.5" stroke-dasharray="3 2" />
    <text x="0" y="7" fill="#854d0e" font-family="'Inter', sans-serif" font-size="18" font-weight="900" text-anchor="middle">1</text>
  </g>

  <rect x="50" y="45" width="220" height="34" rx="6" fill="#082f49" fill-opacity="0.9" stroke="#38bdf8" stroke-width="1.5" />
  <text x="65" y="67" fill="#38bdf8" font-family="'Inter', sans-serif" font-size="12" font-weight="700" letter-spacing="1.5">NSBM AQUATIC COMPLEX</text>
</svg>

