<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="careerBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e1b4b" />
      <stop offset="100%" stop-color="#064e3b" />
    </linearGradient>
    <linearGradient id="glowBrand" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#10b981" />
    </linearGradient>
  </defs>

  <rect width="800" height="450" fill="url(#careerBg)" />

  <g stroke="#38bdf8" stroke-width="1" stroke-opacity="0.2">
    <line x1="120" y1="120" x2="260" y2="80" />
    <line x1="260" y1="80" x2="380" y2="140" />
    <line x1="380" y1="140" x2="520" y2="100" />
    <line x1="520" y1="100" x2="680" y2="160" />
    <line x1="260" y1="80" x2="280" y2="240" />
    <line x1="380" y1="140" x2="420" y2="280" />
    <line x1="520" y1="100" x2="540" y2="240" />
    <circle cx="120" cy="120" r="4" fill="#38bdf8" />
    <circle cx="260" cy="80" r="5" fill="#34d399" />
    <circle cx="380" cy="140" r="6" fill="#38bdf8" />
    <circle cx="520" cy="100" r="5" fill="#10b981" />
    <circle cx="680" cy="160" r="4" fill="#38bdf8" />
  </g>

  <g transform="translate(400, 240)">
    <circle cx="0" cy="0" r="90" fill="#1e293b" fill-opacity="0.8" stroke="url(#glowBrand)" stroke-width="3" />
    <path d="M -90 20 L -45 -10 L -25 10 L -60 40 Z" fill="#3b82f6" />
    <path d="M -110 35 L -80 15 L -65 30 L -95 50 Z" fill="#1e3a8a" />
    <path d="M 90 20 L 45 -10 L 25 10 L 60 40 Z" fill="#10b981" />
    <path d="M 110 35 L 80 15 L 65 30 L 95 50 Z" fill="#065f46" />
    <path d="M -30 -10 C -15 -25 15 -25 30 -10 L 25 15 C 10 25 -10 25 -25 15 Z" fill="#fed7aa" stroke="#ea580c" stroke-width="2" />
    <line x1="-10" y1="-8" x2="10" y2="-8" stroke="#c2410c" stroke-width="2" stroke-linecap="round" />
    <line x1="-12" y1="2" x2="12" y2="2" stroke="#c2410c" stroke-width="2" stroke-linecap="round" />
    <line x1="-8" y1="12" x2="8" y2="12" stroke="#c2410c" stroke-width="2" stroke-linecap="round" />
  </g>

  <g fill="#1e293b" stroke="#334155" stroke-width="2">
    <rect x="80" y="270" width="160" height="130" rx="8" />
    <rect x="100" y="300" width="120" height="14" rx="4" fill="#38bdf8" fill-opacity="0.6" />
    <rect x="100" y="325" width="80" height="8" rx="2" fill="#64748b" />
    <rect x="560" y="270" width="160" height="130" rx="8" />
    <rect x="580" y="300" width="120" height="14" rx="4" fill="#10b981" fill-opacity="0.6" />
    <rect x="580" y="325" width="80" height="8" rx="2" fill="#64748b" />
  </g>

  <g transform="translate(630, 90)">
    <circle cx="0" cy="0" r="28" fill="#065f46" stroke="#34d399" stroke-width="2" />
    <polyline points="-10,0 -2,8 12,-6" fill="none" stroke="#6ee7b7" stroke-width="3" stroke-linecap="round" />
  </g>

  <rect x="50" y="45" width="230" height="34" rx="6" fill="#1e293b" fill-opacity="0.9" stroke="#38bdf8" stroke-width="1.5" />
  <text x="65" y="67" fill="#38bdf8" font-family="'Inter', sans-serif" font-size="12" font-weight="700" letter-spacing="1.5">INDUSTRY CAREER FAIR</text>
</svg>

