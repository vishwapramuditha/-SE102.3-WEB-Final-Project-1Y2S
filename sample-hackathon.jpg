<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="800" height="450">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f0a2e"/>
      <stop offset="60%" stop-color="#1a1050"/>
      <stop offset="100%" stop-color="#0a1628"/>
    </linearGradient>
    <linearGradient id="gbar2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8"/>
      <stop offset="100%" stop-color="#818cf8"/>
    </linearGradient>
    <linearGradient id="overlay2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0f0a2e" stop-opacity="0.97"/>
      <stop offset="55%" stop-color="#0f0a2e" stop-opacity="0.80"/>
      <stop offset="100%" stop-color="#0f0a2e" stop-opacity="0.0"/>
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bg2)"/>
  <!-- Stars / particles -->
  <g fill="#ffffff" opacity="0.25">
    <circle cx="520" cy="50" r="1.5"/><circle cx="580" cy="90" r="1"/><circle cx="640" cy="40" r="1.5"/>
    <circle cx="700" cy="80" r="1"/><circle cx="750" cy="120" r="1.5"/><circle cx="560" cy="130" r="1"/>
    <circle cx="610" cy="200" r="1.5"/><circle cx="730" cy="160" r="1"/><circle cx="780" cy="60" r="1"/>
    <circle cx="540" cy="280" r="1"/><circle cx="680" cy="300" r="1.5"/><circle cx="760" cy="240" r="1"/>
  </g>
  <!-- Laptop illustration -->
  <g transform="translate(460, 70)">
    <!-- Screen -->
    <rect x="40" y="10" width="260" height="180" rx="10" fill="#0a0a1a" stroke="#38bdf8" stroke-width="2"/>
    <rect x="50" y="20" width="240" height="160" rx="6" fill="#050510"/>
    <!-- Code on screen -->
    <text x="60" y="50" font-family="monospace" font-size="11" fill="#38bdf8" opacity="0.9">&gt; hackathon.init()</text>
    <text x="60" y="68" font-family="monospace" font-size="11" fill="#818cf8">&nbsp;&nbsp;teams: 48,</text>
    <text x="60" y="86" font-family="monospace" font-size="11" fill="#34d399">&nbsp;&nbsp;projects: 48,</text>
    <text x="60" y="104" font-family="monospace" font-size="11" fill="#818cf8">&nbsp;&nbsp;duration: "24h",</text>
    <text x="60" y="122" font-family="monospace" font-size="11" fill="#34d399">&nbsp;&nbsp;prize: "LKR 500k"</text>
    <text x="60" y="140" font-family="monospace" font-size="11" fill="#fbbf24">&#123; status: "LIVE" &#125;</text>
    <text x="60" y="158" font-family="monospace" font-size="11" fill="#38bdf8" opacity="0.6">_</text>
    <!-- Keyboard base -->
    <rect x="20" y="190" width="300" height="16" rx="4" fill="#1a1050" stroke="#38bdf8" stroke-width="1.5"/>
    <rect x="0" y="206" width="340" height="8" rx="4" fill="#0f0a2e" stroke="#38bdf8" stroke-width="1"/>
    <!-- Keys hint -->
    <g fill="#1e1060" stroke="#38bdf8" stroke-width="0.5" opacity="0.7">
      <rect x="30" y="193" width="18" height="10" rx="2"/><rect x="52" y="193" width="18" height="10" rx="2"/>
      <rect x="74" y="193" width="18" height="10" rx="2"/><rect x="96" y="193" width="18" height="10" rx="2"/>
      <rect x="118" y="193" width="60" height="10" rx="2"/>
    </g>
    <!-- Trophy icon -->
    <g transform="translate(240, 220)">
      <path d="M20 0 L30 0 L30 25 L20 25 Z" fill="#fbbf24" opacity="0.8"/>
      <path d="M10 0 Q0 10 10 20 L20 20 L20 0 Z" fill="#fbbf24" opacity="0.6"/>
      <path d="M30 0 Q40 10 30 20 L30 0 Z" fill="#fbbf24" opacity="0.6"/>
      <rect x="12" y="25" width="26" height="5" rx="2" fill="#fbbf24" opacity="0.8"/>
      <rect x="8" y="30" width="34" height="4" rx="2" fill="#fbbf24" opacity="0.6"/>
    </g>
  </g>
  <!-- Glow effect behind laptop -->
  <ellipse cx="590" cy="225" rx="180" ry="100" fill="#38bdf8" fill-opacity="0.05"/>
  <!-- Left overlay -->
  <rect width="800" height="450" fill="url(#overlay2)"/>
  <!-- Accent bar -->
  <rect x="0" y="0" width="5" height="450" fill="url(#gbar2)"/>
  <!-- Category badge -->
  <rect x="28" y="30" width="74" height="24" rx="4" fill="#38bdf8"/>
  <text x="65" y="47" font-family="Inter,sans-serif" font-size="11" font-weight="700" fill="#0f0a2e" text-anchor="middle" letter-spacing="0.5">EVENTS</text>
  <!-- Headline -->
  <text x="28" y="105" font-family="Georgia,serif" font-size="27" font-weight="bold" fill="#ffffff">NSBM Green Wave</text>
  <text x="28" y="140" font-family="Georgia,serif" font-size="27" font-weight="bold" fill="#ffffff">Hackathon 2026:</text>
  <text x="28" y="175" font-family="Georgia,serif" font-size="27" font-weight="bold" fill="#38bdf8">Register Now!</text>
  <!-- Excerpt -->
  <text x="28" y="215" font-family="Inter,sans-serif" font-size="13" fill="rgba(255,255,255,0.65)">48 teams, 24 hours, one mission — innovate</text>
  <text x="28" y="233" font-family="Inter,sans-serif" font-size="13" fill="rgba(255,255,255,0.65)">for Sri Lanka's digital future. Open to all.</text>
  <!-- Meta -->
  <text x="28" y="285" font-family="Inter,sans-serif" font-size="11" fill="rgba(255,255,255,0.40)">NSBM NewsDesk  •  Events  •  nsbm.ac.lk</text>
  <!-- NSBM badge -->
  <rect x="28" y="400" width="130" height="28" rx="14" fill="rgba(56,189,248,0.12)" stroke="#38bdf8" stroke-width="1"/>
  <text x="93" y="419" font-family="Inter,sans-serif" font-size="11" font-weight="700" fill="#38bdf8" text-anchor="middle" letter-spacing="0.5">NSBM GREEN UNIV.</text>
</svg>
